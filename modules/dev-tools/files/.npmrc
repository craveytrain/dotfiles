# Shared npm configuration from the dev-tools module.
# Keep machine-specific values and credentials in environment variables or a
# project-level .npmrc outside this repository. npm does not load ~/.npmrc.local.

# Save exact versions in package.json instead of ranges
save-exact=false

# Automatically save dependencies when installing
save=true

# Use strict engine checks
engine-strict=false

# Progress bar display
progress=true

# Audit level (none, low, moderate, high, critical)
audit-level=moderate

# Update notifier
update-notifier=true

# NOTE: Do NOT add auth tokens or registry credentials here
# and do not run `npm config set --location=user`: ~/.npmrc is a symlink to
# this tracked file.
